resource "google_compute_future_reservation" "{{$.PrimaryResourceId}}" {
  provider = google-beta
  name     = "{{index $.ResourceIdVars "future_reservation_name"}}"
  project  = "{{index $.TestEnvVars "project"}}"
  zone     = "us-central1-a"
  auto_delete_auto_created_reservations = true
  planning_status = "SUBMITTED"
  reservation_mode = "CALENDAR"
  reservation_name = "{{index $.ResourceIdVars "reservation_name"}}"
  specific_reservation_required = true
  time_window {
    start_time = "{{ index $.ResourceIdVars "start_time" }}"
    end_time   = "{{ index $.ResourceIdVars "end_time" }}"
  }
  share_settings {
    share_type = "LOCAL"
  }
  aggregate_reservation {
    vm_family = "VM_FAMILY_CLOUD_TPU_POD_SLICE_CT5P"
    reserved_resources {
      accelerator {
        accelerator_count = 1
      }
    }
  }
}
